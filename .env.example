# Odin environment: prod | staging | dev | local | legacy (default: prod)
VITE_ODIN_ENV=prod
# Name shown on the Odin approval page
VITE_ODIN_APP_NAME=Odin Portfolio
# Public origin of the deployed site, no trailing slash. Needed for absolute
# og:image / og:url in social cards; omitted when empty.
VITE_SITE_URL=
